# Required: create an OpenRouter API key and keep the real value only in .env
OPENROUTER_API_KEY=replace_with_your_api_key

# Optional runtime settings
OPENROUTER_API_URL=https://openrouter.ai/api/v1/chat/completions
OPENROUTER_MODEL=openrouter/free
OPENROUTER_APP_TITLE=OpenRouter TypeScript CLI
OPENROUTER_APP_REFERER=http://localhost
OPENROUTER_MAX_TOKENS=700
OPENROUTER_TEMPERATURE=0.2
OPENROUTER_TIMEOUT_MS=60000
